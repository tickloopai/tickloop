# Maintainer-local directories and notes
references/
prototypes/

# Rust
!/vendor/
/vendor/*
!/vendor/crossterm/
!/vendor/crossterm/**
!/vendor/longbridge-oauth/
!/vendor/longbridge-oauth/**
target/
/dist/
/.wrangler/
*.profraw
*.profdata

# Python helpers used by smoke scripts
__pycache__/
*.pyc
*.pyo

# .scratch/ is the local issue tracker: specs, tickets, notes and scripts are committed.
# Rules below drop caches, run outputs, snapshots and native binaries generated inside it.
.scratch/cargo-home/
.scratch/**/before/
.scratch/**/results/
.scratch/**/pycache/
.scratch/**/python-deps/
.scratch/**/*.diff
.scratch/**/*.log
.scratch/**/*.ansi
.scratch/**/*-evidence/
.scratch/**/*.transcript.jsonl

# Native binaries compiled ad hoc (keep the .rs source next to them)
*.dSYM/
*.o
*.a
*.dylib
*.so

# Local Agent build cache, state and credentials
/.scratch/agent/cargo-home/
/.tickloop/*
!/.tickloop/skills/
/.tickloop/skills/*
!/.tickloop/skills/model-integration/
/.env

# Agent module implementation evidence
/.scratch/agent-module-boundaries/results/

# Provider hierarchy validation artifacts
/.scratch/provider-hierarchy/results/

# Provider/model redesign acceptance output
/.scratch/provider-model-picker/evidence/

# design-sync (claude.ai/design) staging, build output and machine state
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
