{
  "tools": [
    {
      "name": "ArtifactRead",
      "description": "Read Tickloop Artifacts you can access. Each artifact has format doc (writing) or design (a visual page). list: your artifacts and those shared with you; query matches titles. read: a doc as blocks, each with id, hash and text, paged by cursor; a page as its whole page source. Both include revision. threads: comment threads (open by default) with their latest messages and any @tickloop request. access_role is owner, edit or view; view can comment but not edit.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list",
              "read",
              "threads"
            ]
          },
          "query": {
            "type": "string",
            "maxLength": 200,
            "description": "Part of a title"
          },
          "cursor": {
            "type": "string",
            "description": "next_cursor from the previous page"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "artifact_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "resolved",
              "all"
            ]
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "ArtifactEdit",
      "description": "create: title, format, content. doc: writing (reports, notes, plans), opens with \"# <title>\". page: visual design, UI, prototypes, mockups, wireframes, dashboards, interactive pages; self-contained page, inline <style>/<script>, only https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js, fit phone widths. patch (doc): target, expected_hash from read; replace, delete or insert before/after a block. replace (page): whole page source, expected_revision from read. rename: title, expected_title from read; an H1 or <title> showing the old title follows. On content_conflict, re-read and merge, never overwrite. On unsupported_doc_syntax, simplify it. Delete, sharing, members, versions: web only.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create",
              "patch",
              "replace",
              "rename"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "format": {
            "type": "string",
            "enum": [
              "doc",
              "page"
            ]
          },
          "content": {
            "type": "string"
          },
          "artifact_id": {
            "type": "string"
          },
          "patches": {
            "minItems": 1,
            "maxItems": 200,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "replace"
                    },
                    "target": {
                      "type": "string",
                      "description": "A block id from read"
                    },
                    "expected_hash": {
                      "type": "string",
                      "description": "That block's hash from read"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "target",
                    "expected_hash",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "delete"
                    },
                    "target": {
                      "type": "string",
                      "description": "A block id from read"
                    },
                    "expected_hash": {
                      "type": "string",
                      "description": "That block's hash from read"
                    }
                  },
                  "required": [
                    "type",
                    "target",
                    "expected_hash"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "insert"
                    },
                    "target": {
                      "type": "string",
                      "description": "A block id from read"
                    },
                    "expected_hash": {
                      "type": "string",
                      "description": "That block's hash from read"
                    },
                    "side": {
                      "type": "string",
                      "enum": [
                        "before",
                        "after"
                      ]
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "target",
                    "expected_hash",
                    "side",
                    "text"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "expected_title": {
            "type": "string",
            "description": "The title read or list returned"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false
      }
    },
    {
      "name": "ArtifactComment",
      "description": "Write in an artifact's comment threads as the user's Agent. reply: answer in a thread, with thread_id from ArtifactRead threads; a reply does not finish a request. done: call only once you have finished the @tickloop request you are handling, or cannot; outcome done or failed, and a non-empty summary is added to its thread. done needs the request context Tickloop sends while you handle that request.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "reply",
              "done"
            ]
          },
          "artifact_id": {
            "type": "string"
          },
          "thread_id": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "enum": [
              "done",
              "failed"
            ]
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "action",
          "artifact_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false
      }
    }
  ]
}
